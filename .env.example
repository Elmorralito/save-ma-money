# Save Ma Money — environment variable template (NFR-05)
# Copy values into the appropriate .env file. NEVER commit real secrets.
#
# 1. Copy this file to modules/api/src/.env  (API Settings load path — required)
# 2. Copy DB_* vars to docker/database/.env  (Docker Compose / Alembic)
#
# Decision record: docs/issues/PPT-031-C-supabase-decision-brief.md (#31)
# Proposed G7: B0 (local dev) + B1 (staging/prod); B2/B3 deferred
# DuckDB is deprecated — use PostgreSQL URLs only; always set DATABASE_URL

# =============================================================================
# Database — B0 local Docker Postgres (development)
# =============================================================================
DATABASE_URL="postgresql+psycopg2://papita:changeme@localhost:5432/papita_transactions"

# Docker Compose (docker/database/.env) — used by docker-compose.yml
# DB_USER="papita"
# DB_PASSWORD="changeme"
# DB_NAME="papita_transactions"
# DB_PORT="5432"

# =============================================================================
# Database — B1 Supabase (staging / production)
# =============================================================================
# Transaction pooler (recommended for FastAPI API runtime, port 6543)
# DATABASE_URL="postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session / direct (Alembic migrations, long jobs — do NOT use transaction pooler)
# DATABASE_URL_MIGRATIONS="postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# =============================================================================
# JWT — required for B0/B1 local auth (AuthSecurityManager)
# =============================================================================
JWT_SECRET_KEY="replace-with-long-random-secret-min-32-chars"
# JWT_ALGORITHM="HS256"
# JWT_EXPIRATION_TIME_SECONDS="3600"
# JWT_TOKEN_TYPE="bearer"

# =============================================================================
# Supabase — optional until B2/B3 (Supabase Auth + RLS)
# =============================================================================
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."  # server-only; never expose to clients

# =============================================================================
# API server
# =============================================================================
# HOST="0.0.0.0"
# PORT="8000"
# DEBUG="false"
# LOG_LEVEL="INFO"
# DATABASE_POOL_SIZE="5"  # defined in Settings; not wired to engine until #25

# =============================================================================
# CORS — restrict in staging/production (never use "*" with credentials)
# =============================================================================
# ALLOWED_ORIGINS='["http://localhost:3000"]'
