# papita_txnsapi — environment template (NFR-05)
# Copy to this directory as .env (Settings load path: modules/api/src/.env)
#
#   cp modules/api/src/.env.example modules/api/src/.env
#
# NEVER commit modules/api/src/.env — placeholders only here.
# Platform: PostgreSQL only (B0 Docker / B1 Supabase). DuckDB is deprecated.
# See also: ../../.env.example (monorepo root) · docker/database/.env (Compose)

# =============================================================================
# Required
# =============================================================================
JWT_SECRET_KEY="replace-with-long-random-secret-min-32-chars"

# B0 — local Docker Postgres (match docker/database/.env: port 5435, db papita)
DATABASE_URL="postgresql+psycopg2://admin:admin@localhost:5435/papita"

# =============================================================================
# Database — B1 Supabase (staging / production)
# =============================================================================
# Transaction pooler (FastAPI runtime, port 6543)
# DATABASE_URL="postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Postgres (Alembic migrations only — not for API runtime pooler)
# DATABASE_URL_MIGRATIONS="postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# =============================================================================
# JWT (AuthSecurityManager — docs/design/ARCHITECTURE.md Part VI)
# =============================================================================
# JWT_ALGORITHM="HS256"
# JWT_EXPIRATION_TIME_SECONDS="3600"
# JWT_TOKEN_TYPE="bearer"

# =============================================================================
# Auth rate limiting (per client IP — disable in tests via AUTH_RATE_LIMIT_ENABLED=false)
# =============================================================================
# AUTH_RATE_LIMIT_ENABLED="true"
# AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
# AUTH_LOGIN_RATE_LIMIT_PER_MINUTE="10"
# AUTH_REGISTER_RATE_LIMIT_PER_MINUTE="5"

# =============================================================================
# API server
# =============================================================================
# APP_NAME="Save Ma Money API"
# HOST="0.0.0.0"
# PORT="8000"
# DEBUG="false"
# LOG_LEVEL="INFO"
# LOG_FILE=""  # unset → papita_txnsapi/config/logger.yaml
# DATABASE_POOL_SIZE="5"

# =============================================================================
# CORS — restrict in staging/production (never use "*" with credentials)
# =============================================================================
# ALLOWED_ORIGINS='["http://localhost:3000"]'
