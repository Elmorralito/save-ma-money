# Variable names only — no secrets. Runtime values live under environments/<env>/.env
# Gmail OAuth (PPT-080 / #174) — headless refresh-token mode (default).

# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
# GMAIL_PROCESSED_LABEL=PAPITA_PROCESSED
# Optional secondary: path to a token JSON (not the default runtime path)
# GMAIL_TOKEN_FILE=

# Email Prefect flow / runner (PPT-082 / #176) — PAPITA_INGESTOR_* (not GMAIL_*)
# PAPITA_INGESTOR_OWNER_ID=
# PAPITA_INGESTOR_LOOKBACK_HOURS=24
# PAPITA_INGESTOR_SCHEDULE_INTERVAL_MINUTES=60
# PAPITA_INGESTOR_FETCH_LIMIT=
# PAPITA_INGESTOR_DRY_RUN=false
# PAPITA_INGESTOR_FLOW_RETRIES=2
# PAPITA_INGESTOR_FLOW_RETRY_DELAY_SECONDS=60

# Persist bridge (B0 Postgres) — same DATABASE_URL pattern as API
# DATABASE_URL=postgresql+psycopg2://admin:admin@localhost:5435/papita
