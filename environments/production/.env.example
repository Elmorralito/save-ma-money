# Environment — production
# Copy to environments/production/.env and replace placeholders. NEVER commit .env.
#
#   cp environments/production/.env.example environments/production/.env
#   export PAPITA_ENV=production
#
# Use a secrets manager in real deploy; this file is for local ops / documented shape only.
# Auth: AUTH_PROVIDER=supabase (PPT-039). DB may be any Postgres (pooler optional).
# Migrations: ./bin/alembic.sh upgrade --url "$DATABASE_URL_MIGRATIONS"

PAPITA_ENV=production

AUTH_PROVIDER="supabase"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_JWT_AUDIENCE="authenticated"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."  # server-only; never expose to clients
JWT_SECRET_KEY="replace-with-long-random-secret-min-32-chars"

DATABASE_URL="postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL_MIGRATIONS="postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

DATABASE_POOL_SIZE="5"
LOG_LEVEL="WARNING"
DEBUG="false"
DOCS_ENABLED="false"
# Never use "*" with credentials in production (Settings rejects "*" when DEBUG=false)
ALLOWED_ORIGINS='["https://app.example.com"]'
ALLOWED_HOSTS='["api.example.com"]'
# HEALTH_RATE_LIMIT_ENABLED="true"
# HEALTH_RATE_LIMIT_PER_MINUTE="60"
# HEALTH_PROBE_TIMEOUT_MS="3000"
#
# PPT-044 client-contract — keep compat flags false in production once clients migrate
# API_BULK_MAX_TRANSACTIONS="100"
# API_REPORT_WINDOW_MAX_DAYS="366"
# API_COMPAT_LEGACY_REPORT_ACCOUNT_400="false"
# API_COMPAT_LEGACY_REFRESH_BALANCES_DEFAULT_TRUE="false"
#
# Body size: also set reverse-proxy / uvicorn limits, e.g.
#   uvicorn ... --limit-max-request-size 1048576
#   nginx: client_max_body_size 1m;

# Redis (PPT-043) — managed Redis URL from secrets manager (never commit real values)
# REDIS_URL="rediss://default:<password>@<host>:6379"
# REDIS_ENABLED="true"
# REDIS_DEFAULT_TTL_SECONDS="60"
# REDIS_RATE_LIMIT_ENABLED="true"
# REDIS_MAX_CONNECTIONS="20"
# API_RATE_LIMIT_ENABLED="true"
# API_RATE_LIMIT_DEFAULT_TIER="free"
