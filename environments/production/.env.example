# Environment — production (B1 Supabase transaction pooler)
# Copy to environments/production/.env and replace placeholders. NEVER commit .env.
#
#   cp environments/production/.env.example environments/production/.env
#   export PAPITA_ENV=production
#
# Use a secrets manager in real deploy; this file is for local ops / documented shape only.
# Migrations: ./deploy/alembic.sh upgrade --url "$DATABASE_URL_MIGRATIONS"

PAPITA_ENV=production

JWT_SECRET_KEY="replace-with-long-random-secret-min-32-chars"

# Supabase Auth (PPT-039)
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

DATABASE_URL="postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL_MIGRATIONS="postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

DATABASE_POOL_SIZE="5"
LOG_LEVEL="WARNING"
# Never use "*" with credentials in production
ALLOWED_ORIGINS='["https://app.example.com"]'

# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
