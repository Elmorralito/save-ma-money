# Environment — staging
# Copy to environments/staging/.env and replace placeholders. NEVER commit .env.
#
#   cp environments/staging/.env.example environments/staging/.env
#   export PAPITA_ENV=staging
#
# Auth smoke (JWT → /auth/me): set AUTH_PROVIDER=supabase + SUPABASE_* below.
# Optional pooler DB smoke: make b1-smoke (not MVP AC after PPT-039 Auth pivot).
#
# Migrations (direct :5432 only):
#   ./bin/bash/alembic.sh upgrade --env staging --url "$DATABASE_URL_MIGRATIONS"

PAPITA_ENV=staging

# Auth (PPT-039) — prefer supabase for staging
AUTH_PROVIDER="supabase"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_JWT_AUDIENCE="authenticated"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."  # server-only; never expose to clients
# Local HS256 fallback (unused when AUTH_PROVIDER=supabase)
JWT_SECRET_KEY="replace-with-long-random-secret-min-32-chars"

# Database — app storage is Docker / any Postgres URL (NOT Supabase storage).
# Supabase is Auth-only (SUPABASE_* above). Optional pooler hosting is parked ops — not MVP.
DATABASE_URL="postgresql+psycopg2://admin:admin@localhost:5435/papita"
# DATABASE_URL_MIGRATIONS only if you host the *app* DB on a remote Postgres (direct :5432, never pooler for Alembic):
# DATABASE_URL_MIGRATIONS="postgresql+psycopg2://postgres:<password>@db.<host>:5432/postgres?sslmode=require"

DATABASE_POOL_SIZE="5"
LOG_LEVEL="INFO"
DEBUG="false"
DOCS_ENABLED="true"
# Web origin(s) only — never "*". Include the nginx SPA host (PPT-057 / #122), e.g.
# http://localhost:3000 for Compose or https://app.staging.example.com in real staging.
ALLOWED_ORIGINS='["http://localhost:3000","https://app.staging.example.com"]'
# Required when DEBUG=false (TrustedHost)
ALLOWED_HOSTS='["localhost","127.0.0.1","api.staging.example.com"]'
# HEALTH_RATE_LIMIT_ENABLED="true"
# HEALTH_RATE_LIMIT_PER_MINUTE="120"
# HEALTH_PROBE_TIMEOUT_MS="3000"

# Redis (PPT-043) — managed Redis for staging horizontal scale (Upstash / ElastiCache / etc.)
# Required for durable BFF cookie sessions (PPT-059), JWT denylist, and distributed RL.
# Prefer fail-closed BFF durability when Redis is required — do not run SPA cookies on
# memory-only API. Keys: papita:{PAPITA_ENV}:bff:session:{id} vs …:jwt:denylist:{digest}.
# Staging Compose / nginx packaging (PPT-057 / #122) must keep Redis in the stack.
# REDIS_URL="rediss://default:<password>@<host>:6379"
# REDIS_ENABLED="true"
# REDIS_DEFAULT_TTL_SECONDS="60"
# REDIS_RATE_LIMIT_ENABLED="true"
# REDIS_MAX_CONNECTIONS="10"
# API_RATE_LIMIT_ENABLED="true"
# API_RATE_LIMIT_DEFAULT_TIER="free"
# BFF_SESSION_MAX_AGE_SECONDS="604800"
# AUTH_COOKIE_SECURE="true"  # required behind HTTPS for papita_sid

# nginx SPA host publish when using docker compose locally against staging-shaped env
# WEB_PORT=3000
# VITE_APP_TITLE=Papita
# VITE_PAPITA_BREAKING_CHANGES_ID=ppt-044
# VITE_API_BASE_URL=  # empty = same-origin /api through nginx
