# Environment — staging (B1 Supabase transaction pooler)
# Copy to environments/staging/.env and replace placeholders. NEVER commit .env.
#
#   cp environments/staging/.env.example environments/staging/.env
#   export PAPITA_ENV=staging
#   make b1-smoke
#
# Migrations (direct :5432 only):
#   ./deploy/alembic.sh upgrade --env staging --url "$DATABASE_URL_MIGRATIONS"
# Or after sourcing this file: ./deploy/alembic.sh upgrade --url "$DATABASE_URL_MIGRATIONS"

PAPITA_ENV=staging

JWT_SECRET_KEY="replace-with-long-random-secret-min-32-chars"

# Supabase Auth (PPT-039) — fill when wiring JWT verify
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Transaction pooler (API runtime + optional pooler smoke) — port 6543
DATABASE_URL="postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Postgres (Alembic only — never transaction pooler)
DATABASE_URL_MIGRATIONS="postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

DATABASE_POOL_SIZE="5"
LOG_LEVEL="INFO"
ALLOWED_ORIGINS='["http://localhost:3000"]'
