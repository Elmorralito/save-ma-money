# Environment — staging
# Copy to environments/staging/.env and replace placeholders. NEVER commit .env.
#
#   cp environments/staging/.env.example environments/staging/.env
#   export PAPITA_ENV=staging
#
# Auth smoke (JWT → /auth/me): set AUTH_PROVIDER=supabase + SUPABASE_* below.
# Optional pooler DB smoke: make b1-smoke (not MVP AC after PPT-039 Auth pivot).
#
# Migrations (direct :5432 only):
#   ./deploy/alembic.sh upgrade --env staging --url "$DATABASE_URL_MIGRATIONS"

PAPITA_ENV=staging

# Auth (PPT-039) — prefer supabase for staging
AUTH_PROVIDER="supabase"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_JWT_AUDIENCE="authenticated"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."  # server-only; never expose to clients
# Local HS256 fallback (unused when AUTH_PROVIDER=supabase)
JWT_SECRET_KEY="replace-with-long-random-secret-min-32-chars"

# Database — B0 Docker or hosted Postgres. B1 pooler is optional (PPT-040).
DATABASE_URL="postgresql+psycopg2://admin:admin@localhost:5435/papita"
# B1 transaction pooler (smoke + optional CI secret SUPABASE_B1_DATABASE_URL):
# SUPABASE_B1_DATABASE_URL="postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL_MIGRATIONS="postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

DATABASE_POOL_SIZE="5"
LOG_LEVEL="INFO"
ALLOWED_ORIGINS='["http://localhost:3000"]'
