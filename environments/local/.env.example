# Environment — local (B0 Docker Postgres)
# Copy to environments/local/.env and edit. NEVER commit .env.
#
#   cp environments/local/.env.example environments/local/.env
#   export PAPITA_ENV=local   # default
#
# Compose: docker compose --env-file environments/local/.env -f docker/docker-compose.yml up
# API Settings and bin/bash/alembic.sh read this file when PAPITA_ENV=local.

PAPITA_ENV=local

# -----------------------------------------------------------------------------
# Auth — prefer Supabase Auth (PPT-039). AUTH_PROVIDER defaults to supabase
# when SUPABASE_URL is set; use AUTH_PROVIDER=local only for HS256 unit/dev tests.
# -----------------------------------------------------------------------------
# AUTH_PROVIDER="supabase"
JWT_SECRET_KEY="replace-with-long-random-secret-min-32-chars"
# JWT_ALGORITHM="HS256"
# JWT_EXPIRATION_TIME_SECONDS="3600"
# JWT_TOKEN_TYPE="bearer"

# Supabase Auth (required for register/login when AUTH_PROVIDER=supabase)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_JWT_AUDIENCE="authenticated"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."  # server-only; never expose to clients
# Required for orphan Auth cleanup when register/login provision fails after Auth create.

# Auth smoke (make auth-smoke) — Supabase rejects .local / example.com
# AUTH_SMOKE_EMAIL="you+smoke@yourdomain.com"
# AUTH_SMOKE_EMAIL_DOMAIN="yourdomain.com"
# AUTH_SMOKE_PASSWORD="SecurePass1!"
#
# Dashboard: Auth → Providers → Email → turn OFF "Confirm email" for local smoke
# (default SMTP is rate-limited and only delivers to org members).
# Or keep Confirm email ON and leave AUTH_AUTO_CONFIRM_EMAIL unset (defaults true
# for PAPITA_ENV=local) with SUPABASE_SERVICE_ROLE_KEY set — local register uses
# Admin create_user (no confirmation email / avoids SMTP 429 rate limits).
# AUTH_AUTO_CONFIRM_EMAIL=true
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."  # required for Admin register + orphan cleanup
#
# OAuth SSO (optional): enable Auth → Providers → Google and/or GitHub in the
# Supabase dashboard. Add BOTH callbacks under Authentication → URL Configuration
# → Redirect URLs (or only the BFF one if the SPA is the primary client):
#   http://localhost:8000/api/v1/auth/oauth/callback          # Bearer / token clients
#   http://localhost:8000/api/v1/bff/auth/oauth/callback      # SPA BFF (papita_sid)
# Prefer pointing SUPABASE_OAUTH_REDIRECT_TO at the BFF callback for local SPA DX.
# With Vite (make web-dev) the browser host is :5173 (proxied /api) — allowlist:
#   http://localhost:5173/api/v1/bff/auth/oauth/callback
# nginx SPA (make web-up) same-origin on WEB_PORT:
#   http://localhost:3000/api/v1/bff/auth/oauth/callback
# Direct API (token clients / no proxy):
#   http://localhost:8000/api/v1/bff/auth/oauth/callback
# SUPABASE_OAUTH_REDIRECT_TO is optional when the start request already builds the
# matching callback via Host; still add every used callback in the Supabase dashboard.
# SUPABASE_OAUTH_REDIRECT_TO="http://localhost:5173/api/v1/bff/auth/oauth/callback"
# Bearer shortcut (non-SPA): GET /api/v1/auth/oauth/google?follow=true
#   → GET /api/v1/auth/oauth/callback?code=... (JSON TokenResponse)

# -----------------------------------------------------------------------------
# API — Settings (runtime API is Compose: make api-up)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql+psycopg2://admin:admin@localhost:5435/papita"
# Optional Settings metadata only — Compose Dockerfile CMD stays 0.0.0.0:8000 (PPT-045).
# Host publish: API_PORT below. Do not run uvicorn on the host for B0.
# HOST="0.0.0.0"
# PORT="8000"
# DEBUG="false"
LOG_LEVEL="INFO"
DATABASE_POOL_SIZE="5"
# Browser origins that may call the API with credentials. Compose injects an explicit
# list by default (see docker/docker-compose.yml) including Vite :5173 and nginx :3000.
# Never use "*" with credentials when DEBUG=false. For cross-origin Vite without proxy,
# keep http://localhost:5173. nginx SPA (make web-up) is same-origin on WEB_PORT — CORS
# is not involved for browser→nginx→/api, but direct :8000 clients still need this list.
# PPT-068: also add http://localhost:5173/auth/confirm (and nginx origin) to the Supabase
# dashboard Redirect URLs / Site URL so confirmation emails land on the SPA.
ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]'

# Auth rate limiting (disable in unit tests via AUTH_RATE_LIMIT_ENABLED=false)
# AUTH_RATE_LIMIT_ENABLED="true"
# AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
# AUTH_LOGIN_RATE_LIMIT_PER_MINUTE="10"
# AUTH_REGISTER_RATE_LIMIT_PER_MINUTE="5"
# AUTH_OAUTH_RATE_LIMIT_PER_MINUTE="20"
# AUTH_COOKIE_SECURE="true"  # omit to follow not DEBUG; set true behind HTTPS

# -----------------------------------------------------------------------------
# Redis (PPT-043) — B0 local deploy
# Host uvicorn → localhost. Compose API service always uses redis://redis:6379/0
# (hardcoded in docker/docker-compose.yml so this host URL is not injected).
# B1: managed Redis URL (Upstash / ElastiCache / etc.) — never commit secrets
#
# BFF cookie sessions (PPT-049 / PPT-059): when REDIS_ENABLED=true, bindings use
# papita:{PAPITA_ENV}:bff:session:{id} — distinct from JWT denylist keys.
# REDIS_ENABLED=false is OK for solo single-worker local DX / unit tests only.
# Multi-worker or staging SPA cookies require Redis. Bearer make auth-smoke does
# not exercise the BFF map.
# Optional cookie lifetime (seconds); default 7d when unset:
# BFF_SESSION_MAX_AGE_SECONDS="604800"
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED="true"
REDIS_DEFAULT_TTL_SECONDS="60"
REDIS_CACHE_TTL_ACCOUNTS_SECONDS="60"
REDIS_CACHE_TTL_CATEGORIES_SECONDS="300"
REDIS_CACHE_TTL_REPORTS_SECONDS="180"
REDIS_CACHE_TTL_TRANSACTIONS_SECONDS="15"
REDIS_IDEMPOTENCY_TTL_SECONDS="86400"
REDIS_RATE_LIMIT_ENABLED="true"
REDIS_MAX_CONNECTIONS="10"
REDIS_PORT=6379
# Tenant API quotas (accounts/categories/transactions/movements/reports)
API_RATE_LIMIT_ENABLED="true"
API_RATE_LIMIT_DEFAULT_TIER="free"
API_RATE_LIMIT_FREE_PER_MINUTE="60"
API_RATE_LIMIT_FREE_PER_DAY="1000"
API_RATE_LIMIT_PRO_PER_MINUTE="300"
API_RATE_LIMIT_PRO_PER_DAY="10000"


# -----------------------------------------------------------------------------
# Docker Compose + Alembic (DB_* / COMPOSE_*)
# -----------------------------------------------------------------------------
COMPOSE_NAME=papita-transactions
# Host publish only (${API_PORT}:8000). In-container listen remains 8000.
API_PORT=8000
# nginx SPA host publish (PPT-057 / #122). make web-up → http://localhost:${WEB_PORT}/
WEB_PORT=3000
# Public Vite build-args for the web image (baked at docker build — not secrets).
# VITE_APP_TITLE=Papita
# VITE_PAPITA_BREAKING_CHANGES_ID=ppt-044
# Leave VITE_API_BASE_URL unset/empty so the SPA uses same-origin /api via nginx.
# VITE_API_BASE_URL=
DB_DRIVER=postgresql+psycopg2
DB_HOST=localhost
DB_PORT=5435
DB_NAME=papita
DB_USER=admin
DB_PASSWORD=admin
# Optional Postgres image aliases (database-only compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=papita
POSTGRES_PORT=5435
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Supabase (B1 pooler / optional B2 Auth) — placeholders for local dual-target work
# Keep B0 DATABASE_URL above active for day-to-day. To hit the pooler from this
# profile, temporarily swap DATABASE_URL to the pooler line (or use PAPITA_ENV=staging).
# Replace <project-ref>, <password>, <region>. Never commit real secrets.
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL_MIGRATIONS="postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
