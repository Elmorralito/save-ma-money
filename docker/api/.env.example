# Docker Compose — API + Postgres stack (docker/docker-compose.yml)
# Copy to docker/api/.env (optional — defaults work for local B0)
#
#   cp docker/api/.env.example docker/api/.env

COMPOSE_NAME=papita-transactions

# Postgres (must match docker/database/.env when sharing the same volume)
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=papita
DB_PORT=5435

# API
API_PORT=8000
JWT_SECRET_KEY=replace-with-long-random-secret-min-32-chars
LOG_LEVEL=INFO

# CORS JSON array (Compose passes through to Settings)
ALLOWED_ORIGINS=["*"]
